    {
      "id": 2,
      "type": "gauge",
      "title": "Uso da CPU",
      "description": "Tempo ocupado na janela de coleta. A origem eBPF/proc aparece na legenda.",
      "datasource": {
        "type": "prometheus",
        "uid": "monix-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "monix-prometheus"
          },
          "expr": "monix_cpu_usage_percent{instance=\"$instance\",job=\"monix\",cpu=\"all\"}",
          "legendFormat": "CPU ({{source}})",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "Indisponível",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "custom": {},
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
