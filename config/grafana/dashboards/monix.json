    {
      "type": "table",
      "title": "Estado das categorias (source / status)",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Valor de status de cada categoria do snapshot. Leituras null não viram zero: aparecem aqui como unavailable/pending/error.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "monix_category_status{instance=~\"$instance\"} == 1",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "category": "Categoria",
              "status": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "available": {
                        "color": "green",
                        "index": 0
                      },
                      "partial": {
                        "color": "yellow",
                        "index": 1
                      },
                      "pending": {
                        "color": "blue",
                        "index": 2
                      },
                      "unavailable": {
                        "color": "text",
                        "index": 3
                      },
                      "error": {
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Categoria",
            "desc": false
          }
        ]
      }
    },
